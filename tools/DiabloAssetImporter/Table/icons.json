{
  "size": 48,
  "background": [16, 12, 10],
  "icons": [
    { "out": "d1/icons/arcane_orbit", "cl2": "missiles\\holy{d}.cl2", "dirs": 16, "width": 96,
      "layers": [ { "dir": 12, "frame": 7 } ] },
    { "out": "d1/icons/fireball", "cl2": "missiles\\fireba{d}.cl2", "dirs": 16, "width": 96,
      "layers": [ { "dir": 12, "frame": 7 } ] },
    { "out": "d1/icons/magic_missile", "cl2": "missiles\\miniltng.cl2", "width": 64,
      "layers": [ { "dir": 0, "frame": 4 } ] }
  ]
