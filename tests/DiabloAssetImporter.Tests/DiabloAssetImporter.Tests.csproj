<Project Sdk="Microsoft.NET.Sdk">

  <!-- 가져오기 도구 시험 (설계서 10.1, 소유 WP0). 합성 바이트·시험이 만든 작은 MPQ 로만 — 원작 자원 없이 돈다.
       바이트 픽스처는 시험 코드의 인코더가 만든다(원본에서 잘라 낸 바이트를 넣지 않는다, R24) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>DiabloAssetImporter.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\DiabloAssetImporter\DiabloAssetImporter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
