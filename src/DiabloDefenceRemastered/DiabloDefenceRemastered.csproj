<Project Sdk="Microsoft.NET.Sdk">

  <!-- 실행 파일: 렌더·입력·화면·앱. MGCB(콘텐츠 파이프라인)는 쓰지 않는다 (설계서 1.3) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DiabloDefenceRemastered</RootNamespace>
    <AssemblyName>DiabloDefenceRemastered</AssemblyName>
    <TieredPGO>true</TieredPGO>
    <!-- 그림 자원 폴더. 검사·복사가 같이 읽는다. 실패 경로 시험은 -p:DdrAssetDir=<빈 폴더> 로 한다 -->
    <DdrAssetDir Condition="'$(DdrAssetDir)' == ''">$(MSBuildProjectDirectory)\Assets</DdrAssetDir>
    <SkipAssetCheck Condition="'$(SkipAssetCheck)' == ''">false</SkipAssetCheck>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6" />
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiabloDefenceRemastered.Core\DiabloDefenceRemastered.Core.csproj" />
  </ItemGroup>

  <!-- Core 는 System.Numerics.Vector2 를 쓴다. XNA 쪽 벡터는 늘 XnaVector2 별칭으로 쓴다 -->
  <ItemGroup>
    <Using Include="System.Numerics" />
    <Using Include="Microsoft.Xna.Framework.Vector2" Alias="XnaVector2" />
    <Using Include="DiabloDefenceRemastered.Core.Common" />
    <Using Include="DiabloDefenceRemastered.Core.Defs" />
    <Using Include="DiabloDefenceRemastered.Core.Data.Registry" />
    <Using Include="DiabloDefenceRemastered.Core.Sim" />
    <Using Include="DiabloDefenceRemastered.Core.Sim.Contracts" />
    <Using Include="DiabloDefenceRemastered.App.Contracts" />
  </ItemGroup>

  <!-- 그림(PNG·cur, git 제외)과 정의 JSON 을 출력 폴더로 복사한다 -->
  <ItemGroup>
    <None Include="$(DdrAssetDir)\*.png;$(DdrAssetDir)\*.cur" Link="Assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CheckAssets" BeforeTargets="BeforeBuild" Condition="'$(SkipAssetCheck)' != 'true'">
    <Error Code="DDR0001" Text="그림 자원이 없다. tools\import-assets.ps1 로 채운다 (README 참고)" Condition="!Exists('$(DdrAssetDir)\Dungeon1.png')" />
  </Target>

</Project>
