// 표시 이펙트·적 투사체 (설계서 6.4, 기획 13.7 — 소유 WP5). 합칠 때(검증 담당) 무기(WP3)·적(WP4)·소리 연결(WP8)이 가리키는 ID 가 없어 넣은 첫 판.
// 기획 13.7 의 원작 그림 중 번개 lghning·화살 arrows 는 아직 가져오기 표에 없어
// 원작 DiabloDefence exe PNG(sprites/missiles.json 의 exe_*) 와 매직 미사일 그림으로 대신한다. 큰 폭발 bigexp·불화살 폭발 firarwex 는 가져온다(v0.9 플레이 관찰). WP0 이 표에 넣으면 WP5 가 sprite·frames 를 기획 표대로 바꾼다.
{
  "effects": [
    // 기획: 번개 lghning 1~8 ×0.35. 대체: 차지드 볼트 miniltng 8프레임
    { "id": "fx_bolt_hit", "sprite": "miniltng", "frames": [1, 8], "loop": false, "frame_time": 0.04, "scale": 0.5, "blend": "alpha" },
    // 보스 묶음 B(기획 v0.9.5 3절·열린 질문 58, 설계서 6.20 ㉑): 순간이동 떠난 자리·도착 자리 = 차지드 볼트 miniltng 를 푸르게(원작 순간이동 그림은 다음 가져오기 때)
    { "id": "fx_blink", "sprite": "miniltng", "frames": [1, 8], "loop": false, "frame_time": 0.03, "scale": 0.9, "tint": [170, 200, 255], "blend": "additive" },
    // 기획: 큰 폭발 bigexp 1~16(칸 160), 반경에 맞춤(그림 반폭 최대 약 68px — 배율 1 일 때 덮는 반경 68), 빛·흔들림
    { "id": "fx_fire_explosion", "sprite": "bigexp", "frames": [1, 16], "loop": false, "frame_time": 0.05,
      "fit_radius": 68, "blend": "alpha",
      "light": { "color": [255, 160, 80], "radius_mul": 1.5, "duration": 0.3 },
      "shake": { "px": 1, "duration": 0.08 } },
    // 기획: 불화살 폭발 firarwex 1~6(칸 64) ×0.6
    { "id": "fx_spark", "sprite": "firarwex", "frames": [1, 6], "loop": false, "frame_time": 0.05, "scale": 0.6, "blend": "alpha" },
    { "id": "fx_warning_line", "procedural": "warning_line", "tint": [255, 40, 40], "alpha": 0.35 },
    // 단계 2(wp4 — 이번에 한해 이 파일은 wp4). 기획 13.7: 붉은 원 예고(코드 그림 — 그리기가 telegraph 원으로 그림), 붉은색 α0.35. 블랙애시 불비
    { "id": "fx_warning_circle", "procedural": "warning_circle", "tint": [255, 40, 40], "alpha": 0.35 },
    // 기획 13.7: 산 웅덩이 acidpud1 1~9(생김, 한 번) → acidpud2 1~4(유지 반복), 반경에 맞춤 — 로트피스트 독 웅덩이. fit_radius 는 첫 값(그림 반폭 어림) — 미리보기로 맞춘다
    { "id": "fx_poison_pool", "sprite": "acidpud2", "frames": [1, 4], "loop": true, "frame_time": 0.1,
      "intro": { "sprite": "acidpud1", "frames": [1, 9] }, "fit_radius": 40, "blend": "alpha" }
  ],
  "projectiles": [
    // 기획 13.7: 화살 arrows 원색 ×0.9, 반경 4, 260px/s, 350px, 장애물 막힘. 대체 그림: exe 화살(16방향)
    // ×0.6 은 바닥 무늬에 묻혀 안 보였다(플레이 관찰) → 기획 값 ×0.9. 그리기가 적 탄 둘레 빛도 더한다
    { "id": "pj_enemy_arrow", "sprite": "exe_arrow", "scale": 0.9, "blend": "alpha",
      "radius": 4, "speed": 260, "range": 350, "blocked_by_obstacles": true, "pierce": 1 },
    // 단계 2(wp4 — 이번에 한해 이 파일은 wp4). 기획 13.7: 불화살 farrow1..16(4프레임) ×0.9, 반경 5, 240px/s, 380px, 장애물 막힘, 맞으면 fx_spark(폭발 피해 없음) — 블랙애시 불화살 부채
    { "id": "pj_fire_arrow", "sprite": "farrow", "scale": 0.9, "blend": "alpha",
      "radius": 5, "speed": 240, "range": 380, "blocked_by_obstacles": true, "pierce": 1, "hit_effect": "fx_spark" },
    // 기획 13.7: 보스 파이어볼 fireba1..16 ×0.9, 반경 10, 260px/s, 600px, 장애물 막힘, 폭발 반경 50·피해 ×1.0·fx_fire_explosion — 해골왕 파이어볼 부채
    { "id": "pj_boss_fireball", "sprite": "fireba", "scale": 0.9, "blend": "alpha",
      "radius": 10, "speed": 260, "range": 600, "blocked_by_obstacles": true, "pierce": 1,
      "explosion": { "damage_mul": 1.0, "radius": 50, "effect": "fx_fire_explosion" } }
  ]
}
