// 소리 연결 표 (설계서 6.15·7.9 표) — 무엇이 일어나면 어느 소리를 내나. 소유 WP8. 키 = 그 종류의 정의 ID(무기·투사체·이펙트·그림 묶음·직업·획득물·보상·스테이지).
// 정의 파일(무기 WP3·적 WP4·이펙트 WP5)에는 소리 ID 를 적지 않는다. 연결이 없는 신호는 소리 없음(화살 맞음처럼 — 기획 12.7).
// 단계 1 내용만 — 단계 2·3 의 무기·몬스터·보스 대사·장판 반복(hazard_loops)·정예 상자·물약 보상은 그 정의와 함께 더한다.
// ui.room_clear 는 걸지 않는다(기획 12.7 v0.8: 방 정리·방 바뀜은 소리 없이 문구·화면 어둡게만).
{
  "sound_bindings": {
    "weapons": {
      "magic_missile": { "fire": "snd_cbolt" },
      "fireball":      { "fire": "snd_fbolt" },
      "arcane_orbit":  { "fire": "snd_holybolt" }
    },
    "projectiles": {
      "pj_enemy_arrow": { "fire": "snd_bfire" },
      "pj_fire_arrow":  { "fire": "snd_bfire" },
      "pj_boss_fireball": { "fire": "snd_fbolt" },
      // 단계 2 보스 묶음 A: 블랙애시 불화살은 전의 pj_fire_arrow 소리, 해골왕 탄막은 전의 pj_boss_fireball 소리를 잇는다.
      // 탄막은 파도마다 신호 하나 — 나선·연사처럼 촘촘한 파도는 같은 소리 min_interval·same_sound(rules.audio)가 거른다.
      // pj_rot_glob(로트피스트 독 덩어리)은 걸지 않는다 — 원작 소리 표에 독 던짐 소리를 아직 들이지 않았다(열린 질문 59 와 함께 정함)
      "pj_ash_arrow":  { "fire": "snd_bfire" },
      "pj_sk_orb":     { "fire": "snd_fbolt" },
      "pj_sk_orb_big": { "fire": "snd_fbolt" }
    },
    "effects": {
      "fx_fire_explosion": "snd_firimp",
      "fx_bolt_hit":       "snd_elecimp"
    },
    "sprite_sets": {
      "set_skelaxe": { "attack": "snd_skelaxe_attack", "hit": "snd_skelaxe_hit", "death": "snd_skelaxe_death" },
      "set_skelbow": { "attack": "snd_skelbow_attack", "hit": "snd_skelbow_hit", "death": "snd_skelbow_death", "special": "snd_skelbow_special" },
      "set_zombie":  { "attack": "snd_zombie_attack",  "hit": "snd_zombie_hit",  "death": "snd_zombie_death",  "special": "snd_zombie_special" },
      "set_skelsd":  { "attack": "snd_skelsd_attack",  "hit": "snd_skelsd_hit",  "death": "snd_skelsd_death",  "special": "snd_skelsd_special" },
      "set_sking":   { "attack": "snd_sking_attack",   "hit": "snd_sking_hit",   "death": "snd_sking_death",   "special": "snd_sking_special" }
    },
    "enemies": {
      "skeleton_king": { "voice": "snd_sking_voice" }
    },
    "pickups": {
      "gem_blue":       { "collect": "snd_gem" },
      "gold":           { "collect": "snd_gold" },
      "healing_potion": { "collect": "snd_invpot", "drop": "snd_flippot" },
      "gem_green":      { "collect": "snd_gem" },
      "gem_red":        { "collect": "snd_gem" }
    },
    "hero": {
      "sorcerer": { "hurt": "snd_sorcerer_hurt", "death": "snd_sorcerer_death" }
    },
    "ui": {
      "menu_move": "snd_titlemov", "menu_select": "snd_titlslct", "level_up": "snd_magic", "chest_open": "snd_chest",
      "elite_pack": "snd_magic1", "door_open": "snd_dooropen", "potion_drink": "snd_invpot",
      // 단계 2(wp4): 회복 문 들어옴 = 물약 소리(기획 12.7 물약 보상 invpot), 사기 = 금화, 상자 → 책 = flipbook, 장비 끼우기 = 칸마다.
      // potion_denied·shop_denied 는 걸지 않는다 — 기획 11.7 "원작 '못 함' 소리 sfx\items\ 중, 없으면 무음" 인데 sfx\items 에 그런 소리가 없다(cantdoit 없음, 원본 확인)
      "heal_on_enter": "snd_invpot", "shop_buy": "snd_shop_gold", "chest_drop": "snd_flipbook",
      "equip": "snd_invgrab", "equip_head": "snd_invcap", "equip_body": "snd_invlarm", "equip_body_heavy": "snd_invharm",
      "equip_shield": "snd_invshiel", "equip_staff": "snd_invstaf", "equip_ring": "snd_invring",
      // 보스 묶음 B: 순간이동 도착(CueKind.Blink). 못 함(BlinkDenied)은 걸지 않는다 — 원작 "못 함" 소리 없음, HUD 충전 칸만 붉게
      "blink": "snd_blink"
    },
    "rewards": {
      "reward_tome":  { "collect": "snd_invbook", "open": "snd_readbook" },
      "reward_chest": { "collect": "snd_chest" },
      // 상인 인사 대사(창이 열릴 때 — 신호 ShopOpen 의 상인을 가리키는 보상)
      "reward_smith":  { "open": "snd_smith_greet" },
      "reward_witch":  { "open": "snd_witch_greet" },
      "reward_healer": { "open": "snd_healer_greet" }
    },
    "music": {
      "title": "mus_title",
      "stage_cathedral": "mus_cathedral"
    }
  }
}
