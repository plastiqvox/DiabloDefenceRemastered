                 "hn": "set_sorcerer_hn", "hu": "set_sorcerer_hu", "ht": "set_sorcerer_ht" },
      "look": "lt",
      "stats": {},                                            // rules.hero.stats 덮어쓰기 — 기본값이 마법사 값이라 비어 있음
      "start_weapons": ["magic_missile"],
      "traits": ["trait_arcane_affinity"] }                   // 특성 = trait 패시브(passives.json)
  ]
