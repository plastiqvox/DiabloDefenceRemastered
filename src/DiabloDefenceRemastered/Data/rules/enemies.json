// 적 공통 규칙 (설계서 6.10 rules/enemies.json, 기획 2.3·2.4·8.1·9.1~9.2·12.6). 소유 WP4. 원본 유래 값이 아니다(기획 첫 값).
// 정예·우두머리 drop_table 은 WP3 드롭 표(dt_elite·dt_unique — 기획 11.1 금화 정예 100%(10~30)). 등급 표가 적 정의의 표보다 앞선다.
{
  "rules": {
    // 2026-11-14 사용자 지적 "정예가 너무 빨리 죽는다": HP 정예 ×3.5 → ×8, 우두머리 ×8 → ×20(바탕 잡몹 HP 가 한두 방용이라 배율이 작으면 1초 안에 녹음)
    "ranks": { "elite":  { "hp": 8, "damage": 1.4, "speed": 1.1, "xp": 4,  "scale": 1.15, "knockback_resist_add": 0.3, "affixes": 1, "drop_table": "dt_elite",
                           "glow": [90, 140, 255], "pulse": { "period": 1.2, "alpha": [0.25, 0.45] } },
               "unique": { "hp": 20,  "damage": 1.6, "speed": 1.1, "xp": 10, "scale": 1.3,  "knockback_resist": 0.8,   "affixes": 2, "drop_table": "dt_unique",
                           "glow": [255, 200, 80] },
               // 2026-11-14 디아2식: unique_chance 로 정예 무리 대신 우두머리 무리(우두머리 1 + 같은 종류 일반 졸개 minions) — 예전엔 정예 무리 대장 하나가 우두머리였다
               "pack":   { "pack_size": [3, 5], "unique_chance": 0.3, "minions": [3, 5], "banner": "정예 무리가 나타났다", "unique_banner": "우두머리가 나타났다",
                           "banner_time": 1.5 },
               // 우두머리 고유 이름(기획 9.2 디아2식): first+second 붙여 쓰고 띄어 title — "썩은이빨 도살자". 낱말은 이 게임 것(원작 이름 표를 옮기지 않음)
               "unique_names": {
                 "first":  ["썩은", "검은", "잿빛", "핏빛", "굶주린", "뒤틀린", "무덤", "그늘", "서리", "쇠", "갈라진", "녹슨"],
                 "second": ["이빨", "발톱", "손", "뼈", "눈", "혀", "갈퀴", "송곳니", "가죽", "등뼈", "턱", "날개"],
                 "title":  ["도살자", "파수꾼", "약탈자", "무덤지기", "학살자", "사냥꾼", "역병쟁이", "칼잡이", "포식자", "망령", "고문관", "배신자"] },
               "max_scale": 1.6 },
    "enemies": { "telegraph_required": { "min_damage": 10, "min_time": 0.4, "melee_reach_over_contact": 50,
                                         "heavy_melee_damage": 25, "heavy_melee_windup": 0.35 },
                 // v0.9.5 보스 탄막 공정 장치(기획 38.1, 설계 6.20 ⑨): 주인공 48px 안에는 탄을 만들지 않음, 탄막·순간이동 예고 ≥ 0.4s, 페이즈 탄 지우기 불꽃 ≤ 24
                 "barrage": { "spawn_clear": 48, "telegraph_min": 0.4, "clear_fx_max": 24 } },
    // 적 투사체 동시 280(v0.9.5 — 200 에서: 해골왕 P3 가 많아야 약 150발, 기획 13.7)
    "caps": { "enemies": 300, "enemies_absolute": 360, "hero_projectiles": 400, "enemy_projectiles": 280, "gems": 300 },
    "spawn": { "band": [40, 200], "tries": 12, "edge_margin": 4, "group": [1, 3], "group_radius": 40, "accumulator_hold": 3,
               "path_detour": 1.5,
               "room_pressure": { "after": 8, "every_nth": 3, "min_distance": 150 } }
  }
}
