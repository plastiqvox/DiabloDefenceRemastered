// 장비 규칙 (설계서 6.19 rules.equipment, 기획 v0.9.2 11.6·11.7 첫 값, 소유 WP3). rules 하위 키 equipment 는 이 파일에만 있다(6.1).
{
  "rules": {
    "equipment": {
      "magic_chance": [0.35, 0.60],                  // 마법 등급 확률 — 액트 1·2(반지는 늘 마법)
      "two_affix_chance": 0.25,                      // 마법 등급의 접사 둘(접두사 + 접미사) — v0.9.1 V7
      "price_roll": [0.75, 0.5], "price_round": 5,   // 접사 값 × (0.75 + 0.5 × 굴림 위치), 5 단위 반올림
      "armor_cap": 15,                               // 방어 상한(모든 출처 합 — v0.9.2 열린 질문 52 답, v0.9 는 10)
      "weight_move": {                               // 무게 → 이동(move_pct) — v0.9.1 V6
        "body":   { "light": 0, "medium": -0.05, "heavy": -0.10 },
        "head":   { "light": 0, "medium": -0.02, "heavy": -0.04 },
        "shield": { "light": 0, "medium": -0.02, "heavy": -0.04 }
      },
      "weight_move_floor": -0.15,                    // move_pct 하한(모든 출처를 합친 뒤)
      "reroll_price": 30, "reroll_step": 30          // 상인 다시 굴리기 30·60·90…
    }
  }
}
