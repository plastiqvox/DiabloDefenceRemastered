// 본뜬 원작 방: 없음 — 대성당 작은 방 B "긴 회랑"(기획 10.8): 가운데를 지나는 nw ↔ se 회랑을 긴 가로 벽 둘이 가르고, 뒤·앞 구석에 기둥 하나씩. 기둥 없는 두 귀퉁이에 석관(2026-11-13).
// 작은 방(설계서 6.11): 메가 16 = 하위 32×32. 둘레·문 넷·진입점은 방 A 와 같다(뒤 문 안쪽 4, 앞 문 N − 6 = 26).
// 벽은 메가 줄 5·9(하위 10·18) — 가로 벽 메가는 위 줄만 막아 회랑 안쪽 폭이 하위 7칸(11..17)이고, ne·sw 문 진입점에서 하위 6칸 넘게 떨어져 150px(13.5-23)를 지킨다.
// 벽 왼쪽 끝은 마감된 끝 조각(wall_end_h), 오른쪽 끝은 보통 벽(설계서 13.16). 벽 끝과 둘레 사이는 하위 4칸 넘게 트여 ne·sw 문에서 회랑으로 돌아 든다.
// 거울판은 벽이 세로(wall_v·wall_end_v)로 바뀌어 회랑이 ne ↔ sw 가 된다.
{
  "maps": [
    {
      "id": "cathedral_room_b", "tileset": "l1", "palette": "l1_1", "size": 16, "mirror": true,
      "room_kinds": ["normal", "elite"],
      "layout": {
        "border": "arch_hall",
        "gates": [ { "id": "gate_nw", "side": "nw" }, { "id": "gate_ne", "side": "ne" },
                   { "id": "gate_se", "side": "se" }, { "id": "gate_sw", "side": "sw" } ],
        "place": [
          { "id": "b_wall_back", "piece": "wall_end_h", "at": [[5, 5]] },
          { "piece": "wall_h", "line": [[6, 5], [9, 5]] },
          { "piece": "wall_cap_h", "at": [[10, 5]] },               // 벽 끝 칸을 끝 기둥으로 — 열린 오른쪽 끝 마감(2026-11-13, L1 에 오른쪽 끝 벽 조각이 없어 단면이 보였다)
          { "id": "b_wall_front", "piece": "wall_end_h", "at": [[5, 9]] },
          { "piece": "wall_h", "line": [[6, 9], [9, 9]] },
          { "piece": "wall_cap_h", "at": [[10, 9]] },
          { "id": "b_pillars", "piece": "pillar", "at": [[3, 3], [12, 12]] },
          { "id": "b_tombs", "piece": "sarcophagus", "at": [[12, 3], [3, 12]] } ] },              // 석관(2026-11-13): 기둥 없는 두 귀퉁이 — 걷기만 막고 시야·투사체는 통과
      "entries": [ { "id": "gate_nw", "outside": [-4, 15.5], "inside": [4, 15.5] },
                   { "id": "gate_ne", "outside": [15.5, -4], "inside": [15.5, 4] },
                   { "id": "gate_se", "outside": [35, 15.5], "inside": [26, 15.5] },
                   { "id": "gate_sw", "outside": [15.5, 35], "inside": [15.5, 26] } ],
      "hero_start": { "tile": [15.5, 15.5], "facing": "south" },
      "anchors": { "center": [15.5, 15.5] },
      "art": "d1/maps/cathedral_room_b"
    }
  ]
}
