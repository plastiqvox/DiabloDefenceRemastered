  "maps": [
    {
      "id": "cathedral_room_c", "tileset": "l1", "palette": "l1_1", "size": 16, "mirror": true,
      "room_kinds": ["normal", "elite"],
      "layout": {
        "border": "arch_hall",
        "gates": [ { "id": "gate_nw", "side": "nw" }, { "id": "gate_ne", "side": "ne" },
                   { "id": "gate_se", "side": "se" }, { "id": "gate_sw", "side": "sw" } ],
        "place": [
          { "id": "c_room_north", "origin": [0, 0], "over_border": true,
            "grid": [ "wall_corner wall_h wall_h wall_h wall_corner",
                      "wall_v      .      .      .      .",
                      "wall_v      .      .      .      .",
                      "wall_v      .      .      .      wall_end_v",
                      "wall_corner wall_post .   .      wall_post  " ] },   // [1,4] 벽 끝 칸을 작은 기둥으로 — 열린 오른쪽 끝 마감(2026-11-13, 덧붙이면 큰 적 문이 좁아져 끝 칸을 바꿈)
          { "id": "c_room_south", "piece": "wall_post", "at": [[11, 11]] },   // 모서리 조각(양쪽 끝이 열려 단면이 보임) 대신 작은 기둥(2026-11-13)
          { "piece": "wall_end_h", "at": [[14, 11]] },
          { "piece": "wall_end_v", "at": [[11, 14]] },
          { "id": "c_pillars", "piece": "pillar", "at": [[6, 9], [9, 6]] } ] },
      "open_center": [5, 5, 11, 11],
      "entries": [ { "id": "gate_nw", "outside": [-4, 15.5], "inside": [4, 15.5] },
                   { "id": "gate_ne", "outside": [15.5, -4], "inside": [15.5, 4] },
                   { "id": "gate_se", "outside": [35, 15.5], "inside": [26, 15.5] },
                   { "id": "gate_sw", "outside": [15.5, 35], "inside": [15.5, 26] } ],
      "hero_start": { "tile": [15.5, 15.5], "facing": "south" },
      "anchors": { "center": [15.5, 15.5], "room_north": [4, 4], "room_south": [26, 26] },
      "room_areas": { "room_north": [0, 0, 4, 4], "room_south": [11, 11, 15, 15] },
      "art": "d1/maps/cathedral_room_c"
    }
  ]
