// 본뜬 원작 방: 없음 — 대성당 작은 방 A "기둥 홀"(기획 10.8 성격 첫 안: 기둥 셋 + 앞쪽 구석에 ┘ 짧은 벽). 원작 DUN 을 본뜨지 않아 13.5-22 대조 줄이 없다.
// 작은 방(설계서 6.11 "방 맵"): 메가 16 = 하위 32×32, 외곽 상자 2048×1152. 둘레·문은 대성당 큰 방과 같은 arch_hall 짜임(문 넷 = 네 변 가운데 하위 4칸 틈).
// 문 넷 진입점: 뒤 문(nw·ne) 안쪽 4, 앞 문(se·sw) 안쪽 N − 6 = 26(설계서 11.1 WP5). 진입점 150px 안에 둘레가 아닌 막힌 칸이 없다(13.5-23 작은 방 검사).
// 기둥은 open_center(메가 [5..10]) 바깥 세 귀퉁이 — 안에 두면 open_center 기둥 상한 2(13.5-19)를 넘는다.
// ┘ 짧은 벽은 오른쪽 아래(앞쪽) — 작은 모서리 기둥 [12,12] + 위·왼쪽 끝이 마감된 끝 조각(세로 [12,11]·가로 [11,12]). 트인 끝이 모두 마감되고(아래·오른쪽 끝 조각은 원작에 없음),
// 벽 뒤 구석은 하위 5칸 트임이라 큰 적도 들어간다(10.1 Nav (c)).
// 이력: 처음 판 [12,12] Γ 는 통합 검증(13.5-4)에서 떨어져 [11,11] Γ(모서리 + 한 칸씩)로 옮겼고, v0.9.4 V14(단계 2 wp5)에서 Γ 의 끝이 잘린 단면으로 보여(플레이 관찰) 지금 ┘ 로 바꿨다.
// 거울판(mirror)은 L1 짝 표(wall_h ↔ wall_v)로 켠다. 배치를 바꾸면 사용자 PC 의 맵 그림이 낡는다(layout_hash).
{
  "maps": [
    {
      "id": "cathedral_room_a", "tileset": "l1", "palette": "l1_1", "size": 16, "mirror": true,
      "room_kinds": ["normal", "elite"],
      "layout": {
        "border": "arch_hall",
        "gates": [ { "id": "gate_nw", "side": "nw" }, { "id": "gate_ne", "side": "ne" },
                   { "id": "gate_se", "side": "se" }, { "id": "gate_sw", "side": "sw" } ],
        "place": [
          { "id": "a_pillars", "piece": "pillar", "at": [[4, 4], [11, 4], [4, 11]] },
          { "id": "a_tombs", "piece": "sarcophagus", "at": [[12, 2], [2, 12]] },   // 오른쪽·왼쪽 귀퉁이 석관(2026-11-13 — 방 내부를 더 채움)
          { "id": "a_wall_post", "piece": "wall_post", "at": [[12, 12]] },
          { "piece": "wall_end_v", "at": [[12, 11]] },
          { "piece": "wall_end_h", "at": [[11, 12]] } ] },
      "open_center": [5, 5, 11, 11],
      "entries": [ { "id": "gate_nw", "outside": [-4, 15.5], "inside": [4, 15.5] },
                   { "id": "gate_ne", "outside": [15.5, -4], "inside": [15.5, 4] },
                   { "id": "gate_se", "outside": [35, 15.5], "inside": [26, 15.5] },
                   { "id": "gate_sw", "outside": [15.5, 35], "inside": [15.5, 26] } ],
      "hero_start": { "tile": [15.5, 15.5], "facing": "south" },
      "anchors": { "center": [15.5, 15.5] },                // Γ 뒤 구석은 두 변이 트여 안쪽 방이 아니다 — room_ 기준점을 두지 않는다
      "art": "d1/maps/cathedral_room_a"
    }
  ]
}
