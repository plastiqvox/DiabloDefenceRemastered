// 획득물 (기획 11.1·11.4, 설계서 6.9·6.18·6.19, 소유 WP3 — floor 칸·pk_book 은 단계 2 wp5 가 이음).
// 그림 두 칸: floor = 원작 바닥 그림(v0.9.1 V8 — sprites/objects.json 의 item_*·obj_*1, 떨어짐 애니 전부 → 마지막 프레임, frame 이 있으면 그 프레임 하나만),
// draw = 대체(원작 exe PNG·코드 그림 gem). 원작 그림을 못 가져온 실행은 draw 로 그린다(6.3 대체 규칙). 끌어당김 룬·정예 상자는 원작 아이템이 없어 draw 만.
{
  "pickups": [
    { "id": "gem_blue",  "kind": "xp", "draw": { "procedural": "gem", "size": [10, 14], "color": [90, 150, 255] }, "value_range": [1, 4], "magnet": true },
    // v0.9.2(설계서 6.9 "보석 그림", 기획 v0.9.3): 영혼석·큰 영혼석 = 원작 마법의 돌 마지막 프레임(20) 하나 + 등급 색 곱하기, 원본 크기. 마름모 draw 는 대체·빛 색
    { "id": "gem_green", "kind": "xp", "draw": { "procedural": "gem", "size": [12, 16], "color": [110, 230, 120] }, "value_range": [5, 19], "magnet": true,
      "floor": { "sprite": "item_rock", "frame": 20, "tint": [110, 230, 120] } },
    { "id": "gem_red",   "kind": "xp", "draw": { "procedural": "gem", "size": [14, 20], "color": [255, 80, 80] }, "value_range": [20, 1000000], "magnet": true,
      "floor": { "sprite": "item_rock", "frame": 20, "tint": [255, 80, 80] } },
    { "id": "gold", "kind": "gold", "draw": { "sprite": "Gold", "scale": 0.5 }, "magnet": true, "floor": { "sprite": "item_goldflip" } },
    // v0.9.1(V9 — 설계서 6.19): 체력 물약은 닿으면 물약 칸에 쌓임(potion_stack — 회복량은 rules.hero.potions), 칸이 가득이면 안 집힘
    { "id": "healing_potion", "kind": "potion_stack", "draw": { "sprite": "HealingPotion", "scale": 0.5 }, "magnet": false, "skip_when_full": true,
      "floor": { "sprite": "item_fbttlebr" } },
    { "id": "mana_surge", "kind": "surge", "amount": 0.5, "duration": 8, "draw": { "sprite": "ManaPotion", "scale": 0.5 }, "magnet": false, "floor": { "sprite": "item_fbttlebb" } },
    { "id": "magnet_rune", "kind": "magnet", "draw": { "sprite": "MagicMissileExplosion", "scale": 0.3, "tint": [255, 210, 90], "frame": 1 }, "magnet": false },
    { "id": "elite_chest", "kind": "chest", "draw": { "sprite": "Gold", "scale": 1.2 }, "magnet": false },
    // 문 보상 물체(v0.8 — draw 대체 그림: 마법서 = 매직 미사일 아이콘, 보물 상자 = 금화 아이콘). floor = 원작 물체(v0.9.1 V8): 책 받침 위 펼친 책(2), 닫힌 상자(1 — 열리면 그리기가 3)
    { "id": "obj_tome",  "kind": "reward", "draw": { "sprite": "MagicMissileICon" }, "magnet": false, "floor": { "sprite": "obj_book1", "frame": 2 } },
    { "id": "obj_chest", "kind": "reward", "draw": { "sprite": "GoldIcon" }, "magnet": false, "floor": { "sprite": "obj_chest1", "frame": 1 } },
    // v0.9.1 V8: 보물 상자를 열면 떨어지는 책(rewards.json reward_chest 의 drop) — 닿으면 그 상자의 꾸러미를 받음. 원작 바닥 책(떨어짐 애니 → 마지막 프레임)
    { "id": "pk_book",   "kind": "reward", "draw": { "sprite": "MagicMissileICon" }, "magnet": false, "floor": { "sprite": "item_fbook" } }
  ]
}
