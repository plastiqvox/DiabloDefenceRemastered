    { "id": "obj_tome",        "source": "grid", "file": "MagicMissileICon.png", "sheet": [48, 48],    "frame": [48, 48],  "origin": [24, 44] },
    { "id": "obj_chest",       "source": "grid", "file": "Gold.png",             "sheet": [96, 1600],  "frame": [96, 160], "frames": 10, "origin": [48, 150] },
    { "id": "obj_potion",      "source": "grid", "file": "HealingPotion.png",    "sheet": [96, 2560],  "frame": [96, 160], "frames": 16, "origin": [48, 150] },
    { "id": "obj_shrine",      "source": "grid", "file": "IncHealth.png",        "sheet": [48, 48],    "frame": [48, 48],  "origin": [24, 44] },
    { "id": "obj_shrine_red",  "source": "grid", "file": "IncMana.png",          "sheet": [48, 48],    "frame": [48, 48],  "origin": [24, 44] },
    { "id": "obj_shrine_dark", "source": "grid", "file": "RegenMana.png",        "sheet": [48, 48],    "frame": [48, 48],  "origin": [24, 44] },

    // 문 위 아이콘(48px — 7.11)·HUD 방 줄. 28px 아이콘은 그리는 쪽이 48 칸에 늘린다
    { "id": "obj_book_icon",        "source": "grid", "file": "MagicMissileICon.png", "sheet": [48, 48], "frame": [48, 48], "origin": [24, 24] },
    { "id": "obj_chest_icon",       "source": "grid", "file": "GoldIcon.png",         "sheet": [28, 28], "frame": [28, 28], "origin": [14, 14] },
    { "id": "obj_potion_icon",      "source": "grid", "file": "HealingPotionIcon.png", "sheet": [28, 28], "frame": [28, 28], "origin": [14, 14] },
    { "id": "obj_shrine_icon",      "source": "grid", "file": "IncHealth.png",        "sheet": [48, 48], "frame": [48, 48], "origin": [24, 24] },
    { "id": "obj_shrine_red_icon",  "source": "grid", "file": "IncMana.png",          "sheet": [48, 48], "frame": [48, 48], "origin": [24, 24] },
    { "id": "obj_shrine_dark_icon", "source": "grid", "file": "RegenMana.png",        "sheet": [48, 48], "frame": [48, 48], "origin": [24, 24] }
  ],
  "sprite_sets": [
    // 상인 그림 묶음(MerchantDef.sprite — 설계서 6.19): 서기 반복 하나(idle). 걷지 않고 충돌이 없어 base_speed·base_radius 는 쓰지 않는다.
    // 프레임 시간은 적지 않는다 — 원작 상인 애니 간격을 원본으로 확인하지 못해(13.5-16 출처 주석을 달 수 없음) 그리는 쪽 첫 값(WorldRenderer.MerchantFrameTime 0.15s)을 쓴다.
    // body_height 는 그림 높이 어림
    { "id": "set_towner_smith",  "base_speed": 1, "base_radius": 14, "body_height": 66, "variants": [""],
      "clips": { "idle": { "sprite": "towner_smith" } } },
    { "id": "set_towner_witch",  "base_speed": 1, "base_radius": 14, "body_height": 56, "variants": [""],
      "clips": { "idle": { "sprite": "towner_witch" } } },
    { "id": "set_towner_healer", "base_speed": 1, "base_radius": 14, "body_height": 66, "variants": [""],
      "clips": { "idle": { "sprite": "towner_healer" } } }
