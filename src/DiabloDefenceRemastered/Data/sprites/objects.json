    { "id": "item_fbttlebb", "source": "atlas", "file": "d1/items/fbttlebb.png", "frame": [96, 160], "directions": 1, "frames": 16, "origin": [47, 143] },
    // 경험치 보석(영혼석·큰 영혼석 — 기획 v0.9.3 11.1): 마법의 돌, 칸 96×96, 20프레임 중 마지막(20) 하나만 쓴다(획득물 floor.frame). 회색 돌이라 색 곱하기가 그대로 먹는다
    { "id": "item_rock",     "source": "atlas", "file": "d1/items/rock.png",     "frame": [96, 96],  "directions": 1, "frames": 20, "origin": [44, 53] },
    // 방 안 물체: 6프레임 — 1 닫힘, 2 열림(내용 있음), 3 열림(빔), 4~6 은 같은 셋의 반대 방향. 상자는 닫힘 1 → 열림(빔) 3(그리기 — 두 단계 보상), 책 받침은 펼친 책 2
    { "id": "obj_chest1",    "source": "atlas", "file": "d1/objects/chest1.png", "frame": [96, 96],  "directions": 1, "frames": 6,  "origin": [42, 87] },
    { "id": "obj_book1",     "source": "atlas", "file": "d1/objects/book1.png",  "frame": [96, 96],  "directions": 1, "frames": 6,  "origin": [42, 86] },
    // 상인(기획 11.7): 서기 반복 한 방향, 96×96 — 그리스월드 16·아드리아 19·페핀 20프레임. 첫 프레임 = 문 위 아이콘(48px 안에 맞춤)
    { "id": "towner_smith",  "source": "atlas", "file": "d1/towners/smithn.png", "frame": [96, 96],  "directions": 1, "frames": 16, "origin": [41, 83] },
    { "id": "towner_witch",  "source": "atlas", "file": "d1/towners/witch.png",  "frame": [96, 96],  "directions": 1, "frames": 19, "origin": [42, 80] },
    { "id": "towner_healer", "source": "atlas", "file": "d1/towners/healer.png", "frame": [96, 96],  "directions": 1, "frames": 20, "origin": [43, 83] },

