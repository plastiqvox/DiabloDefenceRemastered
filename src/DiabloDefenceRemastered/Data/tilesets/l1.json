// 대성당(L1) 타일셋 (설계서 6.11, 첫 판 WP0a — 그 뒤 소유 WP0).
// 번호는 조사 견본(L1 메가타일 견본 그림)으로 골랐고, 성질은 이 PC 의 diabdat 원본 L1.TIL·L1.SOL 을 직접 읽어 sol & 7 을 8글자로 바꿔 적었다.
// 이름 붙인 번호만 성질 표에 둔다(13.5-12). 원작 바이트·DUN 은 넣지 않는다(1.4, R24).
{
  "tilesets": [
    {
      "id": "l1",
      "column_height": 160,
      "floor": [13, 162, 163],                          // 바닥 세 가지를 좌표 해시로 섞는다(기획 10.1)
      "borders": {
        // 해골왕 방 둘레 짜임: 뒤 두 변 = 아치 벽(1 세로·2 가로·4 모서리), 앞 두 변 = 흙 턱(18·19, 모서리 20·23·24)
        "arch_hall": { "corner_n": 4, "edge_ne": 2, "corner_e": 23, "edge_se": 18,
                       "corner_s": 20, "edge_sw": 19, "corner_w": 24, "edge_nw": 1 }
      },
      "gates": {
        // 문 틈 = 열린 바닥 두 메가(13). 끝 조각은 원작 짜임대로 "틈 뒤에서 다시 시작하는 쪽"(변 위 번호가 큰 쪽, end_b)에만 둔다 —
        // 벽 끝 6·7, 흙 턱 끝 23·24 는 번호가 작은 쪽(화면 위 끝)이 마감된 조각이다. 틈 앞쪽(end_a)은 둘레 조각 그대로(견본 그림으로 비교)
        "arch_hall": {
          "nw": { "open": 13, "end_b": 6 },
          "ne": { "open": 13, "end_b": 7 },
          "se": { "open": 13, "end_b": 23 },
          "sw": { "open": 13, "end_b": 24 }
        }
      },
      "pieces": {
        // 안쪽 방·짧은 벽 조각(기획 10.3). 벽 메가는 반만 막는다: 세로 = 왼쪽 열, 가로 = 위 줄, 모서리 = 위 줄 + 왼쪽 열
        "pillar": 15,
        "wall_v": 1, "wall_h": 2, "wall_corner": 4,
        "wall_post": 3,                                 // 작은 모서리 기둥(위-왼 칸만) — 가로 벽이 왼쪽에서, 세로 벽(또는 문 틈)이 위에서 와서 만나는 ┘ 자리(기획 10.1 표)
        "wall_end_v": 6, "wall_end_h": 7,               // 위(번호가 작은) 끝이 마감된 벽 — 세로 6 은 위 끝, 가로 7 은 왼쪽 끝
        "grate_h": 36,                                  // 가로 창살(기둥 + 철책)
        "grate_v": 35,                                  // 세로 창살 — 36 의 거울 짝(원본 하위 칸 배치가 36 의 전치, 기둥 칸 = 위-왼)
        "blood_wall_v": 166, "blood_wall_corner": 168, "blood_wall_h": 169,   // 피 묻은 벽(세로·모서리·가로)
        "blood_floor": 172,                             // 피 바닥
        "door_closed_v": 25,                            // 닫힌 문이 박힌 세로 벽 — 26 의 거울 짝(원본 성질이 26 의 전치)
        "door_closed": 26,                              // 닫힌 문이 박힌 가로 벽(장식으로만 — 기획 10.1). 98 은 피 튄 아치 벽이라 문이 아니다(설계서 13.16)
        "altar": 72, "altar_broken": 71                 // 촛대 기둥 둘을 낀 제단·무너진 제단(2026-11-13) — 네 칸 걷기만 막음(시야·투사체 통과)
      },
      "accents": {
        // 변형(2026-11-13 사용자 요청 "대성당 그림을 더 활용"): 같은 성질의 장식판으로 칸마다 해시로 바꾼다 — 그림만 달라지고 충돌은 그대로.
        // 바닥: 잔잔한 금(69·70)·잔해(133~137). 검은 틈이 있는 금·잔해(67·68·73~78·129·130·132)는 홀로 있으면 구멍처럼 보여 뺐다(캡처 확인), 125·138 은 같은 하위 칸, 45~56 대리석은 이웃과 이어지는 무늬라 섞지 않는다
        "13":  { "chance": 0.15, "with": [69, 70, 133, 134, 135, 136, 137] },
        "162": { "chance": 0.10, "with": [69, 70, 133, 134, 135, 136, 137] },
        "163": { "chance": 0.10, "with": [69, 70, 133, 134, 135, 136, 137] },
        // 아치 벽: 세로(1) = 십자가 107·조각상 벽감 111·금 간 113·무너지는 122·124, 가로(2) = 십자가 108·조각상 112·무너진 114~117
        "1":   { "chance": 0.30, "with": [107, 111, 113, 122, 124] },
        "2":   { "chance": 0.30, "with": [108, 112, 114, 115, 116, 117] }
      },
      "marks": { "pillar": [15], "grate": [36, 35], "closed_door": [26, 25] },
      "mirror": {                                       // 거울판 짝 표(6.11 "거울판", 13.5-12 — 짝은 최종 성질이 전치로 같음, self 는 자기 전치와 같음)
        "pairs": [ ["wall_v", "wall_h"], ["wall_end_v", "wall_end_h"], ["blood_wall_v", "blood_wall_h"],
                   ["grate_h", "grate_v"], ["door_closed", "door_closed_v"] ],
        "self": [ "pillar", "wall_corner", "wall_post", "blood_floor", "blood_wall_corner", "altar", "altar_broken" ]
      },
      "props": {                                        // 출처: 원본 확인(L1.TIL 하위 칸 → L1.SOL 의 sol & 7, 6.11 표)
        "13": "....", "162": "....", "163": "....", "172": "....",
        "1": "X.X.", "6": "X.X.", "166": "X.X.",
        "2": "XX..", "7": "XX..", "169": "XX..", "26": "XX..", "25": "X.X.",
        "4": "XXX.", "168": "XXX.",
        "3": "X...",
        "18": "XXXX", "19": "XXXX", "20": "XXXX", "23": "XXXX", "24": "XXXX",
        "15": "x...",                                   // 기둥: 원본 SOL 13(걷기·투사체, 시야 통과). 시야 보정은 하지 않는다(기획 열린 질문 22 기본값)
        "36": "Xw..",                                   // 출처: DevilutionX 참고(조각 63 보정) — 원본 ww..(기둥 칸도 걷기만), 기둥 칸 X 는 아래 sol_known_diffs
        "35": "X.w.",                                   // 출처: 원본 확인 — 원본 w.w.(하위 62·63, SOL 25 — 기둥 칸도 걷기만). 기둥 칸 X 는 아래 design_diffs(36 의 전치)
        "71": "wwww", "72": "wwww",                     // 제단: 원본 SOL 1(걷기만) 넷
        // 변형 장식판(accents) — 출처: 원본 확인(probe tiles, 2026-11-13)
        "69": "....", "70": "....",
        "133": "....", "134": "....", "135": "....", "136": "....", "137": "....",
        "107": "X.X.", "111": "X.X.", "113": "X.X.", "122": "X.X.", "124": "X.X.",
        "108": "XX..", "112": "XX..", "114": "XX..", "115": "XX..", "116": "XX..", "117": "XX.."
      },
      "sol_known_diffs": [                              // 출처: DevilutionX 참고(L1 SOL 보정 목록의 조각 63 — 창살 기둥 시야·투사체 막힘)
        { "tile": 36, "sub": 0, "sol": "w", "use": "X", "why": "창살 기둥 칸 시야·투사체 막힘 보정(원본 SOL 오류, 원작 수정판이 고침)" }
      ],
      "design_diffs": [                                 // 기획 이유로 원본과 다르게 둔 칸(6.11). 35 기둥 칸의 원작 수정판 보정 여부는 확인하지 못해 보정이라 하지 않는다
        { "tile": 35, "sub": 0, "sol": "w", "use": "X", "why": "창살 기둥 칸은 방향과 상관없이 막음, 거울판 짝(36 의 기둥 칸과 같게)" }
      ]
    }
  ]
